{
  "name": "osva-connectors",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm --filter @osva-ai/connector-github --filter @osva-ai/connector-postgres --filter @osva-ai/connector-shopify lint",
    "typecheck": "pnpm --filter @osva-ai/connector-github --filter @osva-ai/connector-postgres --filter @osva-ai/connector-shopify typecheck",
    "test": "pnpm --filter @osva-ai/connector-github --filter @osva-ai/connector-postgres --filter @osva-ai/connector-shopify test",
    "build": "pnpm --filter @osva-ai/connector-github --filter @osva-ai/connector-postgres --filter @osva-ai/connector-shopify build",
    "verify:boundaries": "node scripts/check-package-boundaries.mjs",
    "test:package-acceptance": "node scripts/package-acceptance.mjs",
    "test:package-acceptance:postgres": "node scripts/package-acceptance-postgres.mjs",
    "test:package-acceptance:shopify": "node scripts/package-acceptance-shopify.mjs",
    "test:package-acceptance:npm-dry-run": "node --test scripts/package-acceptance-npm-dry-run.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "eslint": "^9.39.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.15"
  }
}
