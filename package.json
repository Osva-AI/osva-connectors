{
  "name": "osva-connectors",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm --filter @osva-ai/connector-github lint",
    "typecheck": "pnpm --filter @osva-ai/connector-github typecheck",
    "test": "pnpm --filter @osva-ai/connector-github test",
    "build": "pnpm --filter @osva-ai/connector-github build",
    "verify:boundaries": "node scripts/check-package-boundaries.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "eslint": "^9.39.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.15"
  }
}
